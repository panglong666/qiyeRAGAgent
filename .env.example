# 复制为 .env 后按需修改。默认不配置大模型也可以完整运行。
APP_NAME=星河智能企业制度 AI 助手
APP_HOST=127.0.0.1
APP_PORT=8000
# 必填：会话令牌签名密钥，少于 32 位或保持占位值将拒绝启动
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=请替换为至少32位随机字符串
SESSION_EXPIRE_MINUTES=480

# 知识库默认读取项目根目录下的《员工守则_美化版.docx》
HANDBOOK_PATH=员工守则_美化版.docx
DATABASE_PATH=data/enterprise_ai.db
RAG_INDEX_PATH=data/index.json
RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_MIN_COVERAGE=0.20
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# DeepSeek 通过 OpenAI 兼容协议接入。Key 也可以配置为 Windows 系统环境变量。
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1
